# ==========================================
# Regras de Exclusão Git - Projeto Ciência de Dados
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Ambientes Virtuais (Virtual Environments)
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs e Editores
.vscode/
.idea/
*.swp
*.swo
*~

# Arquivos de Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# Logs e relatórios temporários
*.log
*.sqlite3

# Dados brutos grandes (descomente caso não queira versionar o dataset bruto)
# data/raw/*.csv

